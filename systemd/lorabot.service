[Unit]
Description=LoRaBot private Meshtastic assistant
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
Type=simple
User=lorabot
Group=lorabot
SupplementaryGroups=dialout
WorkingDirectory=/opt/lorabot
ExecStart=/opt/lorabot/.venv/bin/lorabot --config /etc/lorabot/config.ini
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lorabot

[Install]
WantedBy=multi-user.target
